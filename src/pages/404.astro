---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
---
<BaseLayout title={`Page not found · ${SITE.title}`} description="This page does not exist." noindex>
  <main class="wrap" id="main" tabindex="-1">
    <section class="nf in-text prose" aria-labelledby="nf-h">
      <h1 class="name" id="nf-h">Page not found</h1>
      <p>This address does not exist. The <a href="/">homepage</a> lists every project.</p>
    </section>
  </main>
</BaseLayout>
