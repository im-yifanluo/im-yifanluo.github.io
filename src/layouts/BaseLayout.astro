---
// Page shell: head, the sticky glass header (nav ends on the right edge), the footer and the page script (src/scripts:
// header state, active section, separators, print, poster fades, loops). The head's one-line is:inline script ships
// exactly as written, so Prettier skips it.
import '@/styles/fonts.css';
import '@/styles/fallbacks.css';
import '@/styles/tokens.css';
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import { monthHtml } from '@/lib/dates';
import { EMAIL, GITHUB, LINKEDIN, OG_IMAGE_ALT, RESUME, REVISED, SITE } from '@/site.config';
import { SEP } from '@/lib/typography';
import LinkList from '@/components/LinkList.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  noindex?: boolean;
}
const { title, description, home = false, noindex = false } = Astro.props;
const site = Astro.site!; // astro.config.mjs always sets `site`
const canonical = new URL(Astro.url.pathname, site).href;
const og = new URL('/og.jpg', site).href;
const nav = [
  { label: 'Projects', href: home ? '#projects' : '/#projects' },
  { label: 'Experience', href: home ? '#experience' : '/#experience' },
  { label: 'Résumé', href: RESUME },
];
// Footer: the header's two anchors, mirrored. Left at x0 (where the header's name sits): "© year Name · Last updated
// Mon YYYY"; right, ending on the right edge (where the nav ends): the contact links in the hero's order. "Last updated"
// is the newer of the newest News item and the site's content revision (site.config.ts REVISED), so it never points at
// an item that was removed. The year is that month's, so a rebuild never changes it on its own.
const UPDATED = [...(await getCollection('news')).map((n) => n.data.date), REVISED].sort().at(-1)!;
const YEAR = UPDATED.slice(0, 4);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFFFF" />
    {/* prettier-ignore */}<script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap"><div class="bar">
          {home ? (
            <a class="home hn title" href="#top">{SITE.title}</a>
          ) : (
            <a class="home title" href="/">{SITE.title}</a>
          )}
          <nav aria-label="Sections"><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
        </div></div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap"><div class="bar">
          <p class="copy meta"><span class="nw">© <time datetime={YEAR}>{YEAR}</time> {SITE.title}</span
            ><Fragment set:html={SEP} /><span class="upd nw"
              >Last updated <Fragment set:html={monthHtml(UPDATED)}
            /></span></p>
          <LinkList
            items={[
              { label: EMAIL, url: `mailto:${EMAIL}` },
              { label: 'Résumé', url: RESUME },
              { label: 'GitHub', url: GITHUB },
              { label: 'LinkedIn', url: LINKEDIN },
            ]}
          />
        </div></div>
    </footer>
    <script>
      // Bundled and inlined here as a module (astro.config.mjs assetsInlineLimit), so it runs once the page is parsed.
      import { initHeader } from '@/scripts/header';
      import { initSeparators } from '@/scripts/separators';
      import { initPrint } from '@/scripts/print';
      import { initPosterFade } from '@/scripts/poster-fade';
      import { initLoops } from '@/scripts/loops';

      initHeader();
      initSeparators();
      initPrint();
      initPosterFade();
      initLoops();
    </script>
  </body>
</html>
