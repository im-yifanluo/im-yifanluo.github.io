---
// One project diagram, rendered from src/data/diagrams.ts: a whole <figure> (plate + caption) that goes where a figure
// goes.
//   <Diagram id="umi" />                          the diagram's default width (wide: the content column, 880 px)
//   <Diagram id="rag-coverage" width="text" />    the text measure (520 px)
//   <Diagram id="fl" caption={f.caption} />       the page's own caption (project YAML) instead of the data's
// The figure carries fig-wide / fig-text and its caption `cap meta`, like a media figure on a project page.
// `flow` diagrams are real boxes and SVG edges with hover / focus / tap details (Flow.astro + flow.ts, the only JS, loaded
// only on pages that render one); `bars` tables are plain HTML (Bars.astro). Styles: styles/diagrams.css.
import '@/styles/diagrams.css';
import { diagram, type Caption } from '@/lib/diagrams';
import Flow from './Flow.astro';
import Bars from './Bars.astro';

interface Props {
  id: string;
  width?: 'text' | 'wide';
  caption?: Caption;
}
const { id, width, caption } = Astro.props;
const d = diagram(id);
const w = width ?? d.width;
const cap = caption ?? d.caption;
---

{d.kind === 'flow' ? <Flow d={d} width={w} caption={cap} /> : <Bars d={d} width={w} caption={cap} />}
