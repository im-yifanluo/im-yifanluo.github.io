---
// One media box, by its reference (lib/media.ts MediaRef): a poster with an optional loop (PosterBox), or a drawing in
// HTML/SVG (OrderStrip, in its hero form for a figure).
import type { MediaRef } from '@/lib/media';
import PosterBox from './PosterBox.astro';
import OrderStrip from './OrderStrip.astro';

interface Props {
  ref: MediaRef;
  box: 'tile' | 'hero' | 'figure';
  sizes: string;
  href?: string;
  eager?: boolean;
}
const { ref, box, sizes, href, eager } = Astro.props;
---

{'drawn' in ref ? (
  <OrderStrip box={box === 'tile' ? 'tile' : 'hero'} href={href} />
) : (
  <PosterBox ref={ref} box={box} sizes={sizes} href={href} eager={eager} />
)}
