{
  "name": "yifan-luo-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:links": "node scripts/check-dist.mjs --external-links",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "media": "node scripts/media/build.mjs",
    "media:portrait": "node scripts/media/portrait.mjs",
    "fonts:fallbacks": "node scripts/fonts/fallbacks.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
